historico = []

def salvar(novo_calculo):
  historico.append(novo_calculo)
  if len(historico) > 7:
    historico.pop(0)

def soma(n1, n2):
  return n1 + n2

def sub(n1, n2):
  return n1 - n2

def mult(n1, n2):
  return n1 * n2

def div(n1, n2):
    if n2 == 0:
        return None
    return n1 / n2

print("***** Projeto calculadora *****")

while True:
  menu = """
  \n Digite o número da operação desejada: \n
 1 - Soma
 2 - Subtração
 3 - Multiplicação
 4 - Divisão
 9 - Histórico de Resultados
 0 - Sair
 """
  print(menu)

  opcao = input("\n Opção: ")

  if opcao not in ["1", "2", "3", "4", "9", "0"]:
    print("  !!!! OPÇÃO INVÁLIDA !!!!     \n!!!! Digite outra opção !!!!")
    continue

  if opcao == "9":
    print("  ---- Histórico ----")
    if not historico:
      print("Nenhum cálculo encontrado.")
    for operacao in historico:
      print(operacao)
    continue

  if opcao == "0":
    print("\n Encerrando calculadora...")
    break

  try:
    n1 = float(input("Digite o primeiro número: "))
    n2 = float(input("Digite o segundo número: "))
  except ValueError:
    print("!!!! Digite apenas números !!!!")
    continue

  if opcao == "1":
    resultado = soma(n1, n2)
    salvar(f"{n1} + {n2} = {resultado}")

  elif opcao == "2":
    resultado = sub(n1, n2)
    salvar(f"{n1} - {n2} = {resultado}")

  elif opcao == "3":
    resultado = mult(n1, n2)
    salvar(f"{n1} * {n2} = {resultado}")

  elif opcao == "4":
    resultado = None
    if n2 == 0:
        print("!!!! Não é possível dividir por zero !!!!")
        continue
    resultado = div(n1, n2)
    salvar(f"{n1} / {n2} = {resultado}")

  print(f"-- Resultado: {resultado}")
