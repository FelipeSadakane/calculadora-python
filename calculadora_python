print("***** Projeto calculadora ***** \n")

while True:
  print("\n Digite o número da operação desejada: \n")
  print("1 - Soma")
  print("2 - Subtração")
  print("3 - Multiplicação")
  print("4 - Divisão")
  print("0 - Sair")

  opcao = input("\n Escolha: ")

  if opcao not in ["1", "2", "3", "4", "0"]:
    print("!!!! Opção inválida !!!!")
    continue

  if opcao == "0":
    print("\n Encerrando calculadora...")
    break

  try:
    num1 = float(input("Digite o primeiro número: "))
    num2 = float(input("Digite o segundo número: "))
  except ValueError:
    print("!!!! Digite apenas números !!!!")
    continue

  if opcao == "1":
    resultado = num1 + num2

  elif opcao == "2":
    resultado = num1 - num2

  elif opcao == "3":
    resultado = num1 * num2

  elif opcao == "4":
    if num2 == 0:
      print("!!!! Não é possível dividir por zero !!!!")
      continue
    resultado = num1 / num2

  print(f"-- Resultado: {resultado}")
