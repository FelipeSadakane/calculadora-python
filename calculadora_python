print("***** Projeto calculadora ***** \n")

def soma(n1, n2):
  return n1 + n2

def sub(n1, n2):
  return n1 - n2

def mult(n1, n2):
  return n1 * n2

def div(n1, n2):
    if n2 == 0:
        return None
    return n1 / n2

while True:
  print("\n Digite o número da operação desejada: \n")
  print("1 - Soma")
  print("2 - Subtração")
  print("3 - Multiplicação")
  print("4 - Divisão")
  print("0 - Sair")

  opcao = input("\n Escolha: ")

  if opcao not in ["1", "2", "3", "4", "0"]:
    print("!!!! Opção inválida !!!!")
    continue

  if opcao == "0":
    print("\n Encerrando calculadora...")
    break

  try:
    n1 = float(input("Digite o primeiro número: "))
    n2 = float(input("Digite o segundo número: "))
  except ValueError:
    print("!!!! Digite apenas números !!!!")
    continue

  if opcao == "1":
    resultado = soma(n1, n2)

  elif opcao == "2":
    resultado = sub(n1, n2)

  elif opcao == "3":
    resultado = mult(n1, n2)

  elif opcao == "4":
    resultado = None
    if n2 == 0:
        print("!!!! Não é possível dividir por zero !!!!")
        continue
    resultado = div(n1, n2)

  print(f"-- Resultado: {resultado}")
